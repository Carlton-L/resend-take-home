# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by Drizzle
DATABASE_URL=

# Resend, used as the SMTP provider for auth email and for notifications
RESEND_API_KEY=

# Routes every .test name to the fake resolver so each failure state is reachable without a real
# broken domain. Off by default, and .test stays refused as a special-use name.
DOMAINCLAIM_TEST_NAMESPACE=off
