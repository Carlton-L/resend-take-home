# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres. DATABASE_URL is the transaction pooler on 6543, which the app uses: a function opens a
# connection per invocation and the pooler is what keeps that from exhausting the database.
# DIRECT_DATABASE_URL is the session pooler on 5432, which drizzle-kit needs because transaction
# pooling cannot hold a prepared statement across statements.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Resend, used for the sign in email and later for status change notifications
RESEND_API_KEY=

# Keys the hashes in the rate limit table and signs the address shown on the confirmation page.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# The origin every emailed link is built from. Never taken from the request, because a forged Host
# header would otherwise put someone else's origin into a mail carrying a live token. Falls back to
# VERCEL_URL on a preview, then to localhost.
APP_ORIGIN=http://localhost:3000

# Routes every .test name to the fake resolver so each failure state is reachable without a real
# broken domain. Off by default, and .test stays refused as a special-use name.
DOMAINCLAIM_TEST_NAMESPACE=off

# Development only. The LAN address the dev server is reached on from another device,
# for example 192.168.1.194. Without it the page loads on a phone and never hydrates.
DEV_ORIGIN=
